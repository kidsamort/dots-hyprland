#!/usr/bin/env bash
# dots — управление dotfiles (stow + install-files + git)
set -euo pipefail

# ─── Пути ──────────────────────────────────────────────────────────────────
DOTDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$DOTDIR/.dotfiles.yaml"
EDITOR="${EDITOR:-nano}"

# ─── Цвета ─────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${CYAN}dots${NC} $1"; }
ok()    { echo -e "${GREEN}✓${NC} $1"; }
warn()  { echo -e "${YELLOW}⚠${NC} $1"; }
err()   { echo -e "${RED}✗${NC} $1"; }

# ─── Проверки ──────────────────────────────────────────────────────────────
require_yq() { command -v yq &>/dev/null || { err "yq не найден (нужен для YAML).\n  yay -S yq  # или brew install yq"; exit 1; }; }

# ─── Вывод справки ──────────────────────────────────────────────────────────
cmd_help() {
  cat <<EOF
${CYAN}dots${NC} — управление dotfiles

${GREEN}Использование${NC}:
  dots ${YELLOW}apply${NC}         Удалить конфликты → stow → hyprctl reload
  dots ${YELLOW}deploy${NC}        install-files --skip-miscconf → dot apply
  dots ${YELLOW}edit <alias>${NC}  Открыть файл в \$EDITOR (см. aliases в .dotfiles.yaml)
  dots ${YELLOW}status${NC}        Статус симлинков, конфликты, git статус
  dots ${YELLOW}up [msg]${NC}      git add → commit → push
  dots ${YELLOW}add <path>${NC}    Добавить файл в managed
  dots ${YELLOW}remove <path>${NC} Убрать файл из managed
  dots ${YELLOW}init${NC}          Сканировать ~/.config/, сгенерировать манифест
  dots ${YELLOW}setup${NC}         Установить dots в систему (PATH, автодополнение)
  dots ${YELLOW}fresh${NC}         Инструкция для чистой установки
  dots ${YELLOW}help${NC}          Эта справка

EOF
  exit 0
}

# ─── apply ──────────────────────────────────────────────────────────────────
cmd_apply() {
  require_yq
  info "Удаляю конфликтные файлы..."

  cd "$DOTDIR"

  local count=0
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local target="$HOME/$path"
    if [ -f "$target" ] && [ ! -L "$target" ]; then
      rm -f "$target"
      warn "удалил обычный файл: $path"
      ((count++))
    fi
  done < <(yq '.managed[]' "$MANIFEST")

  if [ "$count" -eq 0 ]; then
    ok "Конфликтов нет"
  fi

  info "Применяю stow..."
  stow --no-folding \
    --ignore="^bin" \
    --ignore="^cache" \
    --ignore="^dots" \
    --ignore="^dots-extra" \
    --ignore="^\.dotfiles\.yaml" \
    --ignore="^\.git" \
    --ignore="^\.github" \
    --ignore="^\.gitignore" \
    --ignore="^\.gitmodules" \
    --ignore="^LICENSE" \
    --ignore="^licenses" \
    --ignore="^README" \
    --ignore="^sdata" \
    --ignore="^setup$" \
    --ignore="^diagnose$" \
    -d "$DOTDIR" -t "$HOME" .

  info "Перезагружаю Hyprland..."
  if hyprctl reload 2>/dev/null; then
    ok "Готово"
  else
    warn "Hyprland не запущен — пропускаю reload"
  fi
}

# ─── deploy ─────────────────────────────────────────────────────────────────
cmd_deploy() {
  cd "$DOTDIR"
  info "Запускаю install-files..."
  ./setup install-files --skip-miscconf

  info "Чищу мусор..."
  while IFS= read -r pattern; do
    [[ -z "$pattern" ]] && continue
    find "$HOME/.config/hypr" "$HOME/.config/quickshell" -name "$pattern" -type f 2>/dev/null | while IFS= read -r f; do
      if [ ! -L "$f" ]; then
        rm -f "$f"
        warn "удалил: $f"
      fi
    done
  done < <(yq '.clean.patterns[]' "$MANIFEST")

  cmd_apply
}

# ─── edit ────────────────────────────────────────────────────────────────────
cmd_edit() {
  require_yq
  local key="${1:-}"
  local path
  path="$(yq ".aliases.$key" "$MANIFEST")"

  if [ "$path" = "null" ] || [ -z "$path" ]; then
    # Показать список алиасов
    info "Доступные алиасы:"
    yq '.aliases | to_entries | .[] | "  \(.key) → \(.value)"' "$MANIFEST"
    echo ""
    read -rp "Введите алиас или путь: " key
    path="$(yq ".aliases.$key" "$MANIFEST")"
    if [ "$path" = "null" ] || [ -z "$path" ]; then
      # Проверка — может это прямой путь
      if [ -f "$DOTDIR/$key" ]; then
        path="$key"
      else
        err "Неизвестный алиас: $key"
        exit 1
      fi
    fi
  fi

  local fullpath="$DOTDIR/$path"
  if [ ! -f "$fullpath" ]; then
    err "Файл не найден: $fullpath"
    exit 1
  fi

  $EDITOR "$fullpath"
  ok "Файл сохранён. Примени: dots apply"
}

# ─── status ─────────────────────────────────────────────────────────────────
cmd_status() {
  require_yq
  cd "$DOTDIR"

  echo ""
  echo -e "${CYAN}≡ Конфиги${NC}"
  echo "──────────────────────────"
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local target="$HOME/$path"
    if [ -L "$target" ]; then
      local link_target
      link_target="$(readlink -f "$target")"
      if [ "$link_target" = "$(readlink -f "$DOTDIR/$path")" ]; then
        ok "$path"
      else
        warn "$path → ${link_target//$HOME/\~} (не из dotfiles)"
      fi
    elif [ -f "$target" ]; then
      err "$path — обычный файл (не симлинк)! Нужен dots apply"
    else
      warn "$path — отсутствует (возможно не запускали dots apply)"
    fi
  done < <(yq '.managed[]' "$MANIFEST")

  echo ""
  echo -e "${CYAN}≡ Git${NC}"
  echo "──────────────────────────"
  if git diff --stat --cached 2>/dev/null | grep -q .; then
    warn "Есть staged изменения:"
    git diff --stat --cached
  fi
  if git diff --stat 2>/dev/null | grep -q .; then
    warn "Есть unstaged изменения:"
    git diff --stat
  else
    ok "Чисто"
  fi

  echo ""
  local ahead behind
  ahead="$(git rev-list --count origin/main..HEAD 2>/dev/null || echo 0)"
  behind="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
  if [ "$ahead" -gt 0 ]; then
    warn "Впереди на $ahead коммитов (не запушено)"
  fi
  if [ "$behind" -gt 0 ]; then
    err "Сзади на $behind коммитов (нужен pull)"
  fi
  if [ "$ahead" -eq 0 ] && [ "$behind" -eq 0 ]; then
    ok "Всё запушено"
  fi
}

# ─── up ─────────────────────────────────────────────────────────────────────
cmd_up() {
  cd "$DOTDIR"

  info "Добавляю изменения..."
  git add -A

  if ! git diff --cached --stat | grep -q .; then
    warn "Нет изменений для коммита"
    exit 0
  fi

  local msg="${1:-}"
  if [ -z "$msg" ]; then
    echo "Введите сообщение коммита (Enter = пусто → выйдет):"
    read -rep "→ " msg
    [ -z "$msg" ] && { err "Отменено"; exit 1; }
  fi

  git commit -m "$msg"
  info "Пушаю в origin..."
  git push
  ok "Готово"
}

# ─── add ────────────────────────────────────────────────────────────────────
cmd_add() {
  require_yq
  local path="$1"
  [[ -z "$path" ]] && { err "Укажи путь: dot add .config/hypr/custom/xxx.lua"; exit 1; }

  cd "$DOTDIR"

  # Проверка что файл существует в dotfiles
  [ -f "$DOTDIR/$path" ] || { err "Файл не найден: $DOTDIR/$path"; exit 1; }

  # Проверка что уже не в managed
  if yq ".managed[] | select(. == \"$path\") | ." "$MANIFEST" 2>/dev/null | grep -q .; then
    warn "Уже в managed: $path"
    exit 0
  fi

  yq -i ".managed += [\"$path\"]" "$MANIFEST"
  ok "Добавлено: $path"
  info "Примени: dots apply"
}

# ─── remove ─────────────────────────────────────────────────────────────────
cmd_remove() {
  require_yq
  local path="$1"
  [[ -z "$path" ]] && { err "Укажи путь: dot remove .config/hypr/custom/xxx.lua"; exit 1; }

  cd "$DOTDIR"

  if ! yq ".managed[] | select(. == \"$path\") | ." "$MANIFEST" 2>/dev/null | grep -q .; then
    err "Нет в managed: $path"
    exit 1
  fi

  yq -i "del(.managed[] | select(. == \"$path\"))" "$MANIFEST"
  ok "Удалено: $path"
  info "Совет: сделай dots apply, чтобы убрать симлинк"
}

# ─── init ────────────────────────────────────────────────────────────────────
cmd_init() {
  cd "$DOTDIR"
  info "Сканирую ~/.config/ на предмет твоих файлов (не из dots/)..."

  local dirs_to_scan=(
    "$HOME/.config/hypr/custom"
    "$HOME/.config/fish/conf.d"
    "$HOME/.config/matugen"
    "$HOME/.config/quickshell/ii/scripts/colors"
  )

  local found=()
  for dir in "${dirs_to_scan[@]}"; do
    [ -d "$dir" ] || continue
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      # Убираем $HOME/ из пути
      local rel="${f#$HOME/}"
      # Проверка — не в dots/?
      if [ ! -f "$DOTDIR/dots/$rel" ]; then
        found+=("$rel")
      fi
    done < <(find "$dir" -type f)
  done

  if [ ${#found[@]} -eq 0 ]; then
    warn "Ничего нового не найдено"
    exit 0
  fi

  info "Найдены файлы:"
  for f in "${found[@]}"; do
    echo "  $f"
  done

  echo ""
  read -rp "Добавить все в managed? (Y/n) " ans
  case "$ans" in
    n|N|no) info "Ок, ничего не меняю" ;;
    *)
      for f in "${found[@]}"; do
        if ! yq ".managed[] | select(. == \"$f\") | ." "$MANIFEST" 2>/dev/null | grep -q .; then
          yq -i ".managed += [\"$f\"]" "$MANIFEST"
          ok "Добавлено: $f"
        fi
      done
      info "Готово. Запусти dots apply"
      ;;
  esac
}

# ─── setup ───────────────────────────────────────────────────────────────────
cmd_setup() {
  local bindir="$HOME/.local/bin"
  local fishconf="$DOTDIR/.config/fish/conf.d/local.fish"

  info "Устанавливаю dots..."

  # 1. Symlink в ~/.local/bin
  mkdir -p "$bindir"
  local target="$bindir/dots"
  if [ -L "$target" ] && [ "$(readlink -f "$target")" = "$(readlink -f "$DOTDIR/bin/dots")" ]; then
    ok "Симлинк уже есть: $target"
  else
    ln -sf "$DOTDIR/bin/dots" "$target"
    ok "Симлинк создан: $target"
  fi

  # 2. Добавить ~/.local/bin в PATH для fish (если ещё нет)
  if [ -f "$fishconf" ] && grep -q "local/bin" "$fishconf" 2>/dev/null; then
    ok "PATH уже настроен в fish"
  else
    echo "" >> "$fishconf"
    echo "# dots: ~/.local/bin в PATH" >> "$fishconf"
    echo 'fish_add_path -g ~/.local/bin 2>/dev/null; or set -gx PATH ~/.local/bin $PATH' >> "$fishconf"
    ok "Добавил ~/.local/bin в PATH ($fishconf)"
  fi

  # 3. Автодополнение для fish
  local compdir="$HOME/.config/fish/completions"
  mkdir -p "$compdir"
  cp "$DOTDIR/bin/completions/dots.fish" "$compdir/dots.fish"
  ok "Автодополнение установлено"

  # 4. stow
  info "Запускаю dots apply..."
  cmd_apply

  info "Готово. Теперь dots доступна из любого места: dots help"
}

# ─── fresh ───────────────────────────────────────────────────────────────────
cmd_fresh() {
  cat <<EOF
${CYAN}Установка с нуля${NC}

1. Клонируй репозиторий:
   git clone git@github.com:kidsamort/dots-hyprland.git ~/dotfiles
   cd ~/dotfiles

2. Установи dots в систему:
   bin/dots setup

3. Восстанови секреты:
   cp /путь/к/бэкапу ~/.bashrc_secrets
   chmod 600 ~/.bashrc_secrets

4. Перезагрузись:
   reboot
EOF
}

# ─── Главная ────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    apply)   cmd_apply "$@" ;;
    deploy)  cmd_deploy "$@" ;;
    edit)    cmd_edit "$@" ;;
    status)  cmd_status "$@" ;;
    up)      cmd_up "$@" ;;
    add)     cmd_add "$@" ;;
    remove)  cmd_remove "$@" ;;
    init)    cmd_init "$@" ;;
    setup)   cmd_setup "$@" ;;
    fresh)   cmd_fresh "$@" ;;
    help|--help|-h) cmd_help ;;
    *)       err "Неизвестная команда: $cmd"; echo "Запусти: dots help"; exit 1 ;;
  esac
}

main "$@"
